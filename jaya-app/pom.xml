<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ocsin.jaya</groupId>
    <artifactId>jaya</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>jaya-app</artifactId>
  <name>Jaya App</name>
  <description>Serveur local : repository Oak, API REST et GraphQL.</description>
  <dependencies>
    <dependency>
      <groupId>com.ocsin.jaya</groupId>
      <artifactId>jaya-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>com.ocsin.jaya</groupId>
      <artifactId>jaya-oak</artifactId>
    </dependency>
    <dependency>
      <groupId>com.ocsin.jaya</groupId>
      <artifactId>jaya-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>com.ocsin.jaya</groupId>
      <artifactId>jaya-graphql</artifactId>
    </dependency>
    <dependency>
      <groupId>com.ocsin.jaya</groupId>
      <artifactId>jaya-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jersey.containers</groupId>
      <artifactId>jersey-container-grizzly2-http</artifactId>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jersey.inject</groupId>
      <artifactId>jersey-hk2</artifactId>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jersey.media</groupId>
      <artifactId>jersey-media-json-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.inject</groupId>
      <artifactId>javax.inject</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
  <build>
    <finalName>jaya-app</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.ocsin.jaya.app.JayaApplication</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-runtime</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
